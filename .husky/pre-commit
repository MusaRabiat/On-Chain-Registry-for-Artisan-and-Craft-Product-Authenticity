#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "Running pre-commit hooks..."

# Check for Clarity contract syntax
echo "Checking Clarity contracts..."
if command -v clarinet &> /dev/null; then
    clarinet check
    if [ $? -ne 0 ]; then
        echo "Clarity contract check failed. Please fix errors before committing."
        exit 1
    fi
else
    echo "Warning: clarinet not found, skipping contract check"
fi

# Run contract tests
echo "Running contract tests..."
npm test 2>/dev/null || echo "Warning: npm test not available or failed"

# Check for secrets in staged files
echo "Checking for potential secrets..."
STAGED_FILES=$(git diff --cached --name-only)
SECRET_PATTERNS="password|secret|api_key|private_key|AWS_|PINATA_"

for FILE in $STAGED_FILES; do
    if [ -f "$FILE" ]; then
        # Skip binary files and specific file types
        case "$FILE" in
            *.png|*.jpg|*.jpeg|*.gif|*.ico|*.lock|*.woff|*.woff2|*.ttf)
                continue
                ;;
        esac

        if grep -iE "$SECRET_PATTERNS" "$FILE" 2>/dev/null | grep -v "\.example\|\.sample\|process\.env\|NEXT_PUBLIC" > /dev/null; then
            echo "Warning: Potential secret found in $FILE"
            echo "Please review before committing."
        fi
    fi
done

echo "Pre-commit checks passed!"
